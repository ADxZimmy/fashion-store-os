# Fashion Store OS server configuration (Phase 021: local-first).
#
# Business records live on each device. The server holds identity (accounts,
# sessions, invites, recovery codes), encrypted backups it cannot read, and a
# transit inbox for provider webhooks. All of that is one Postgres database.

# Neon Postgres. Set automatically when Neon is added to the Vercel project
# from the Storage tab; POSTGRES_URL is accepted as a fallback. Local dev does
# not need this: `npm run dev` uses an embedded Postgres under data/pglite.
DATABASE_URL=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require

# Protects /api/maintenance (the daily retention sweep). Vercel Cron sends it
# as a bearer token automatically when set.
CRON_SECRET=replace-with-a-long-random-string

# Channel intake. Providers cannot say which store a message belongs to, so
# one store is named here; until it is set, webhook deliveries are refused
# rather than guessed at.
FASHION_STORE_INBOX_STORE_ID=
CHANNEL_WEBHOOK_VERIFY_TOKEN=replace-with-provider-verify-token
CHANNEL_WEBHOOK_SECRET=replace-with-provider-signing-secret
CHANNEL_WEBHOOK_REQUIRE_SIGNATURE=1
CHANNEL_WEBHOOK_MAX_MESSAGES=25

# Only when Neon gives each preview deployment its own database branch:
# DB_MIGRATE_ON_PREVIEW=1
